# Copy to .env and fill in. Never commit .env.
#
# Create an app at https://developer.spotify.com/dashboard, then add the exact
# redirect URI below to the app's settings (Spotify requires an exact match).

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/auth/callback

# Signs the session cookie that holds the Spotify token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

FLASK_ENV=development

# --- Optional tuning ------------------------------------------------------
# FN_HOST=127.0.0.1
# FN_PORT=5000
# FN_LOG_LEVEL=INFO

# Graph cache
# FN_CACHE_ENABLED=true
# FN_CACHE_KEEP_SNAPSHOTS=3
# FN_CACHE_DIR=/absolute/path/to/cache

# Safety ceiling on tracks pulled from one playlist
# FN_MAX_PLAYLIST_TRACKS=2000

# Keep artists who only appear on solo tracks (they render as isolated nodes)
# FN_INCLUDE_SOLO_ARTISTS=true
